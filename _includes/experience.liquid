<div class="experience">
  <div class="table-responsive">
    <table class="table table-sm table-borderless">
      {% for item in site.data.experience %}
        <tr>
          <th scope="row" style="width: 20%">{{ item.period }}</th>
          <td>{{ item.text }}</td>
        </tr>
      {% endfor %}
    </table>
  </div>
</div>
